+        assert obj.valid_from == AS_OF
+
+
+def test_判断轨按实体精确匹配_不串轨(db: str, ck: Path) -> None:
+    other = slice_river(AS_OF, ALIAS_ENTITY, db_path=db, checkpoints_path=ck)
+    assert isinstance(other.tracks["judgment"], Gap)
