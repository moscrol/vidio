+    _, rep = ex.export("p1", fake_user, with_confidence=False)
+    flagged = {f["field"] for f in rep["possible_verbatim"]}
+    assert not any(f.startswith("market_lenses") for f in flagged), f"正常描述被误标：{flagged}"
