+def _sector_quote(sl: RiverSlice) -> RiverObject | None:
+    """盘面轨里那条来自 ``fact_sector_daily`` 的量价行。
+
+    盘面轨同时发两个 ``object_type="label"``：量价行与涨停热度行（``source_view="limit_heat"``）。
