+        return [
+            {
+                "trade_date": f"2026-03-{i + 1:02d}",
+                **{f: nxt() * 3 for f in rw.COMPARABLE_FEATURE_NAMES},
+            }
+            for i in range(28)
+        ]
+
+    monkeypatch.setattr(rw, "build_daily_vectors", fake_build)
+    res = river_lens.lens_from_db(knowledge_cutoff="2026-03-20", window=5, step=5)
