+def test_holdout_days_are_not_all_the_same_reading(sidecar: Path) -> None:
+    """常量探测：若实现永远返回 01-12 的值或永远返回同一个常量，上一条也会通过，这条不会。"""
+    seen: set[Any] = set()
+    for day in _holdout_days(sidecar):
