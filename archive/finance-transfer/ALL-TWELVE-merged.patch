+
+def test_判断轨的_ref_用记录自带的稳定_id(sl: RiverSlice) -> None:
+    judgment = sl.tracks["judgment"]
+    assert not isinstance(judgment, Gap), "判断轨夹具没被读到——这条断言又变回假门禁了"
