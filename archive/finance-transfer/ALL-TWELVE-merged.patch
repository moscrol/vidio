+# scripts/teaching_framework.py:1309 STRUCTURE_ENTITY_LABELS 是同一份名单的 SSOT 对侧。
+STRUCTURE_LABELS = (
+    "tf.macd_bottom_div_observe", "tf.macd_bottom_div_confirm",
+    "tf.macd_bottom_div_failed", "tf.macd_top_div",
+)
