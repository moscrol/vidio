@@ -0,0 +1,118 @@
+"""买卖/策略口径三处一致性检查。
+
+- **正常样本**：当前快照画像（三处同为 blanket）→ 自洽。
+- **反例**：只改一处 → blanket 与 scoped 混用 → 必须判矛盾。这是 P3 真正要防的事故。
+- **未参与调试的验证样本**：风远与 SPT 两份画像（检查器不是对着它们写的）→ 不得崩，且结论可解释。
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from scripts.check_profile_boundary_consistency import check, classify
+
+SNAPSHOT = Path("docs/cloud-research-context/snapshots/2026-10-07/profiles")
+CANDIDATE = Path("docs/learning/perspective-boundary/2026-10-07-strategy-scope-candidate.json")
+
+pytestmark = pytest.mark.skipif(not SNAPSHOT.exists(), reason="快照不在")
+
+
+def _user_framework() -> dict:
+    return json.loads((SNAPSHOT / "user_framework.json").read_text(encoding="utf-8"))
+
+
+# --------------------------------------------------------------------------- #
+# 正常样本
+# --------------------------------------------------------------------------- #
+def test_current_profile_states_the_same_boundary_in_all_three_places() -> None:
+    res = check(_user_framework())
+    assert len(res["loci"]) == 3, f"口径声明处数变了：{[g['where'] for g in res['loci']]}"
+    assert {g["where"] for g in res["loci"]} == {
+        "anti_patterns[0]", "reasoning_patterns[13]", "voice_guidance",
+    }
+    assert res["verdicts"] == ["blanket"]
+    assert res["consistent"]
+
+
+def test_anti_pattern_entry_counts_as_prohibition_without_a_negation_word() -> None:
+    """「给交易建议/仓位建议」被**列在** anti_patterns 里本身就是禁止，不需要再写「不」。"""
+    assert classify("给交易建议/仓位建议（系统边界：只做分析与证据分层）", "anti_patterns[0]") == "blanket"
+    assert classify("给交易建议/仓位建议（系统边界：只做分析与证据分层）", "voice_guidance") == "neutral"
+
+
+# --------------------------------------------------------------------------- #
+# 反例：只改一处
+# --------------------------------------------------------------------------- #
+def test_changing_only_one_of_the_three_places_is_caught() -> None:
+    profile = _user_framework()
+    profile["anti_patterns"][0] = (
+        "未经明确授权用途时给个股买卖/仓位建议；面向持牌机构或团队内部且授权用途已明确时不记为反模式"
+    )
+    res = check(profile)
+    assert not res["consistent"], "只改了 anti_patterns，另两处仍是无条件禁止，却没被判矛盾"
+    assert set(res["verdicts"]) == {"blanket", "scoped"}
+
+
+@pytest.mark.parametrize("where", ["anti_patterns", "reasoning_patterns", "voice_guidance"])
+def test_any_single_locus_left_behind_is_caught(where: str) -> None:
+    """三处里漏掉任意一处都要被抓到，不只是漏掉 anti_patterns 那一种。"""
+    scoped_note = "；面向持牌机构或团队内部且授权用途明确时可输出选股与组合策略"
+    profile = _user_framework()
+    if where != "anti_patterns":
+        profile["anti_patterns"][0] += scoped_note
+    if where != "reasoning_patterns":
+        profile["reasoning_patterns"][13]["rule"] += scoped_note
+    if where != "voice_guidance":
+        profile["voice_guidance"] += scoped_note
+    res = check(profile)
+    assert not res["consistent"], f"漏改 {where} 没被抓到"
+
+
+def test_changing_all_three_is_consistent_again() -> None:
+    scoped_note = "；面向持牌机构或团队内部且授权用途明确时可输出选股与组合策略"
+    profile = _user_framework()
+    profile["anti_patterns"][0] += scoped_note
+    profile["reasoning_patterns"][13]["rule"] += scoped_note
+    profile["voice_guidance"] += scoped_note
+    res = check(profile)
+    assert res["consistent"] and res["verdicts"] == ["scoped"]
+
+
+# --------------------------------------------------------------------------- #
+# 候选文件自身
+# --------------------------------------------------------------------------- #
+@pytest.mark.skipif(not CANDIDATE.exists(), reason="候选不在")
+def test_candidate_touches_exactly_the_three_loci_and_cites_its_source() -> None:
+    cand = json.loads(CANDIDATE.read_text(encoding="utf-8"))
+    assert cand["status"] == "candidate", "候选不能标成已应用"
+    assert cand["decision"]["resolved_to"] == "2026-09-20 7fe048decc27"
+    assert {c["where"] for c in cand["changes"]} == {
+        "anti_patterns[0]", "reasoning_patterns[13].rule", "voice_guidance",
+    }
+    ids = {s["id"] for s in cand["sources"]}
+    assert "7fe048decc27" in ids and "298b8fbcba91" in ids
+    # 不是无条件放开：默认档必须仍然守红线
+    after = " ".join(str(c.get("after", "") or c.get("after_tail", "")) for c in cand["changes"])
+    assert "默认档" in after and "授权" in after
