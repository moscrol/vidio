      "needs_review": 1,
      "rules": [
        {
          "text": "大量资金沉淀的主线必做复杂结构顶、必有回流",
          "status": "clear",
          "review_reasons": [],
          "rule_id": "sptfei.筹码与结构.001",
          "text_sha256": "c9a680899d3e"
        },
        {
          "text": "新主线确认=临突破或新上升趋势早期，且在断代日/老主线反弹时仍能主动抢到资金，不是只当对立面",
          "status": "clear",
          "review_reasons": [],
          "rule_id": "sptfei.筹码与结构.002",
          "text_sha256": "86434ad54bcf"
        },
        {
          "text": "宽度夺价=概念板块与申万行业板块共振，才确认主线在扩散",
          "status": "clear",
          "review_reasons": [],
          "rule_id": "sptfei.筹码与结构.003",
          "text_sha256": "eeb40e6f0e9d"
        },
        {
          "text": "伴身板块=底部N型有强度但非临突破，只配当轮动或主线高潮后的分歧承接",
          "status": "clear",
          "review_reasons": [],
          "rule_id": "sptfei.筹码与结构.004",
          "text_sha256": "1d68f06dfe57"
        },
        {
          "text": "共建主线阶段主线越轮越强（缩量分歧或分歧后强修复），非主线越轮越弱（结构有瑕疵）",
          "status": "clear",
          "review_reasons": [],
          "rule_id": "sptfei.筹码与结构.005",
          "text_sha256": "2906a8ab6c10"
        },
        {
          "text": "承接板块=底部N字+放量+离压力位远",
          "status": "clear",
          "review_reasons": [],
          "rule_id": "sptfei.筹码与结构.006",
          "text_sha256": "5d2c5d989c6c"
        },
        {
          "text": "临近突破状态",
          "status": "standalone",
          "review_reasons": [],
          "rule_id": "sptfei.筹码与结构.007",
          "text_sha256": "27c3fe2e0607",
          "adjudication": {
            "by": "agent",
            "at": "2026-10-07",
            "delegated_by_user": true,
            "verdict": "独立条目，不是上一条的后半截",
