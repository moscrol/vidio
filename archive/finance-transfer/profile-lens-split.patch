+"""拆分器：只拆不删、判不准不静默、逐字可还原。
+
+样本三类：
+- **正常**：手写的小段落（拆分器的启发式就是对着 SPT 调的，所以 SPT 本身算调试样本）。
+- **反例**：跨分号的复合规则 / 残句 / 括号被切断 / 还原校验本身必须会失败。
+- **未参与调试的验证样本**：风远与用户框架的全部镜头——启发式调参时没看过它们，
+  逐字还原必须同样成立。
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from scripts.split_monolithic_lens import (
+    split_description,
+    split_lens,
+    verify_lossless,
+)
+
+SNAPSHOT = Path("docs/cloud-research-context/snapshots/2026-10-07/profiles")
+
+
+# --------------------------------------------------------------------------- #
+# 正常样本
+# --------------------------------------------------------------------------- #
+def test_plain_semicolon_list_splits_one_rule_per_clause() -> None:
+    rules = split_description("主线缩量回踩支撑才认回流；放量杀跌后次日缩量是弱回流；二次量顶后老二级转横盘")
+    assert [r["text"] for r in rules] == [
+        "主线缩量回踩支撑才认回流",
+        "放量杀跌后次日缩量是弱回流",
+        "二次量顶后老二级转横盘",
+    ]
+    assert all(r["status"] == "clear" for r in rules)
+
+
+def test_condition_and_conclusion_joined_by_comma_stay_in_one_rule() -> None:
+    """作者用「，」连条件与结论、用「；」分条——这种情况不能被切断。"""
+    rules = split_description("左底确认优先放量+回归周均线，量不足则站稳周均线；缺口后放量普反才认有左底")
+    assert len(rules) == 2
+    assert "量不足则站稳周均线" in rules[0]["text"], "条件与结论被分号切断了"
+    assert all(r["status"] == "clear" for r in rules)
+
+
+# --------------------------------------------------------------------------- #
+# 反例
+# --------------------------------------------------------------------------- #
+def test_conclusion_severed_by_a_semicolon_is_flagged_not_silently_split() -> None:
+    """反例 1（本轮要求的那条）：故意把条件与结论用分号隔开。
+
+    机器判不准「否则不升级为主线」是独立规则还是上一条的后半截，
+    必须标出来交人裁，而不是挑一个看起来合理的切法然后不说。
+    """
+    rules = split_description("过渡性板块必须横盘后再次放量突破压力位；否则不升级为主线")
+    assert len(rules) == 2
+    assert rules[1]["status"] == "needs_review"
+    assert "否则" in rules[1]["review_reasons"][0]
+    assert "后半截" in rules[1]["review_reasons"][0]
+
+
+def test_bare_noun_phrase_fragment_is_flagged() -> None:
+    """反例 2：真实命中的那条——「临近突破状态」是上一条的附加状语。"""
+    rules = split_description("承接板块=底部N字+放量+离压力位远；临近突破状态；抱团补涨范式")
+    assert rules[1]["text"] == "临近突破状态"
+    assert rules[1]["status"] == "needs_review"
+    assert "名词短语" in rules[1]["review_reasons"][0]
+
+
+def test_semicolon_inside_parentheses_is_flagged_by_bracket_check() -> None:
+    """反例 3：分号切在括号内部 → 括号不配对，必须报出来。"""
+    rules = split_description("容量板块量顶（成交额占比上阈值；资金流入高位）同时出现")
+    assert any(r["status"] == "needs_review" for r in rules)
+    assert any("括号" in rsn for r in rules for rsn in r["review_reasons"])
+
+
+def test_lossless_check_actually_fails_when_a_rule_is_dropped() -> None:
+    """反例 4：还原校验本身不能是空的——少一条必须抛。"""
+    original = "甲；乙；丙"
+    rules = split_description(original)
+    verify_lossless(original, rules)                    # 完整时通过
+    with pytest.raises(AssertionError, match="拆分不可逆"):
+        verify_lossless(original, rules[:-1])           # 少一条必须抛
+
+
+def test_lossless_check_fails_when_text_is_quietly_edited() -> None:
+    """反例 5：悄悄润色一个字也必须被抓到（「只拆不删」同时意味着「只拆不改」）。"""
+    original = "主线缩量回踩支撑才认回流；二次量顶后老二级转横盘"
+    rules = split_description(original)
+    rules[0]["text"] = rules[0]["text"].replace("才认", "即可认")
+    with pytest.raises(AssertionError, match="拆分不可逆"):
+        verify_lossless(original, rules)
+
+
+# --------------------------------------------------------------------------- #
+# 真实画像：SPT（调试样本）
+# --------------------------------------------------------------------------- #
+@pytest.mark.skipif(not (SNAPSHOT / "sptfei.json").exists(), reason="快照不在")
+def test_spt_two_monolithic_lenses_split_losslessly() -> None:
+    profile = json.loads((SNAPSHOT / "sptfei.json").read_text(encoding="utf-8"))
+    total = 0
+    for name in ("量能状态机", "筹码与结构"):
+        out = split_lens(profile, name, profile_id="sptfei")   # 内部已跑 verify_lossless
+        assert out["rule_count"] >= 30
+        assert all(r["rule_id"].startswith(f"sptfei.{name}.") for r in out["rules"])
+        assert len({r["rule_id"] for r in out["rules"]}) == out["rule_count"], "ID 有重复"
+        assert all(len(r["text_sha256"]) == 12 for r in out["rules"])
+        total += out["rule_count"]
+    assert total >= 80, f"两个镜头合计只拆出 {total} 条，与实测 86 条差太多"
+
+
+@pytest.mark.skipif(not (SNAPSHOT / "sptfei.json").exists(), reason="快照不在")
+def test_rule_ids_are_stable_across_runs(tmp_path: Path) -> None:
+    profile = json.loads((SNAPSHOT / "sptfei.json").read_text(encoding="utf-8"))
+    a = split_lens(profile, "量能状态机", profile_id="sptfei")
+    b = split_lens(profile, "量能状态机", profile_id="sptfei")
+    assert [r["rule_id"] for r in a["rules"]] == [r["rule_id"] for r in b["rules"]]
+    assert [r["text_sha256"] for r in a["rules"]] == [r["text_sha256"] for r in b["rules"]]
+
+
+# --------------------------------------------------------------------------- #
+# 未参与调试的验证样本：风远 + 用户框架的全部镜头
+# --------------------------------------------------------------------------- #
+@pytest.mark.parametrize("pid", ["fengyuan", "user_framework"])
+def test_holdout_profiles_split_losslessly_too(pid: str) -> None:
+    """启发式是对着 SPT 调的；换两份没调过的画像，逐字还原必须同样成立。"""
+    path = SNAPSHOT / f"{pid}.json"
+    if not path.exists():
+        pytest.skip("快照不在")
+    profile = json.loads(path.read_text(encoding="utf-8"))
+    lenses = [x.get("name") for x in profile.get("market_lenses") or []]
+    assert lenses, f"{pid} 没有镜头"
+    for name in lenses:
+        out = split_lens(profile, name, profile_id=pid)   # 不过 verify_lossless 就抛
+        assert out["rule_count"] >= 1
+        assert out["clear"] + out["needs_review"] == out["rule_count"]
